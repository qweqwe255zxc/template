# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — сам .env* игнорируем (там секреты), но .env.example коммитим,
# он документирует нужные переменные и не содержит настоящих значений
.env*
!.env.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# дамп кода для разговора с ИИ — генерируется по требованию, в репозитории не нужен
repomix-output.xml
